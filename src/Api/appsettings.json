{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "WebApiConfiguration": {
    "WebApiName": "Bitai.LDAPWebApi",
    "WebApiTitle": "LDAP Web API (BITAI)",
    "WebApiDescription": "Web API to search and authenticate on LDAP Server.",
    "WebApiVersion": "v1",
    "WebApiContactName": "Viko Bastidas",
    "WebApiContactMail": "vico.bastidas@gmail.com",
    "WebApiContactUrl": "https://www.linkedin.com/in/victorbastidasg/",
    "WebApiLicenseName": "MIT",
    "SwaggerUI": true
  },
  "WebApiCorsConfiguration": {
    "CorsPolicyName": "LdapGatewayCorsPolicy",
    "AllowAnyOrigin": false,
    "AllowedOrigins": [      
    ]
  },
  "ApiScopesConfiguration": {
    "BypassApiScopesAuthorization": false,
    "AdminApiScopeName": "Bitai.LDAPGateway.Scope.Admin",
    "ReaderApiScopeName": "Bitai.LDAPGateway.Scope.Reader"
  },
  "AuthorityConfiguration": {
    "Authority": "https://sts.skoruba.local",
    "ApiResource": "Bitai.LDAPGateway.Resource.Api",
    "RequireHttpsMetadata": true
  },
  "SwaggerUIApiClient": {
    "SwaggerUIClientId": "Bitai.LDAPGateway.Local.Swagger.Client",
    "SwaggerUIClientSecret": "",
    "SwaggerUITargetApiScopes": [
      {
        "SwaggerUITargetApiScopeName": "Bitai.LDAPGateway.Scope.Reader",
        "SwaggerUITargetApiScopeTitle": "BITAI LDAP Gateway Reader Scope"
      },
      {
        "SwaggerUITargetApiScopeName": "Bitai.LDAPGateway.Scope.Admin",
        "SwaggerUITargetApiScopeTitle": "BITAI LDAP Gateway Admin Scope"
      }
    ]
  },
  "ServiceConnectionAdapter": {
    "AdapterType": "MockAdapter"
  },
  "LDAPServerProfiles": [
    {
      "ProfileId": "EDU",
      "Server": "192.168.7.253",
      "DefaultDomainName": "IE",
      "BindAccountName": "IE\\accountName",
      "BindAccountPassword": "",
      "ConnectionTimeout": 10,
      "HealthCheckPingTimeout": 100,
      "Port": "Default",
      "UseSSL": false,
      "BaseDN": "DC=ie,DC=edu,DC=pe",
      "PortForGlobalCatalog": "Default",
      "UseSSLforGlobalCatalog": false,
      "BaseDNforGlobalCatalog": "DC=edu,DC=pe"
    },
    {
      "ProfileId": "AIR",
      "Server": "10.11.58.13",
      "DefaultDomainName": "AIRPE",
      "BindAccountName": "AIRPE\\accountName",
      "BindAccountPassword": "",
      "ConnectionTimeout": 10,
      "HealthCheckPingTimeout": 100,
      "Port": "Default",
      "UseSSL": false,
      "BaseDN": "DC=pe,DC=air,DC=com",
      "PortForGlobalCatalog": "Default",
      "UseSSLforGlobalCatalog": false,
      "BaseDNforGlobalCatalog": "DC=air,DC=com"
    }
  ]
}
